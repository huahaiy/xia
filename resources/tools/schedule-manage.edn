;; Manage scheduled tasks — pause, resume, remove, view history.
;; Import with: /import-tool resources/tools/schedule-manage.edn

{:id          :schedule-manage
 :name        "schedule-manage"
 :description "Manage a scheduled task: pause, resume, remove, or view run history."
 :tags        #{:schedule :automation :task :history}
 :approval    :session
 :parameters  {"type"       "object"
               "properties" {"id"     {"type"        "string"
                                       "description" "Schedule identifier"}
                             "action" {"type"        "string"
                                       "enum"        ["pause" "resume" "remove" "history" "details"]
                                       "description" "Action to perform"}}
               "required"   ["id" "action"]}
 :handler-var xia.tool.builtin/schedule-manage}
