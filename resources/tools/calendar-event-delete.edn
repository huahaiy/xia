;; Delete a calendar event.
;; Import with: /import-tool resources/tools/calendar-event-delete.edn

{:id          :calendar-event-delete
 :name        "calendar-event-delete"
 :description "Delete a calendar event by id."
 :tags        #{:calendar :event :delete}
 :approval    :session
 :parameters  {"type"       "object"
               "properties" {"event_id"     {"type"        "string"
                                              "description" "Provider event id to delete"}
                             "calendar_id"  {"type"        "string"
                                              "description" "Optional provider calendar id"}
                             "service_id"   {"type"        "string"
                                              "description" "Optional calendar service id if more than one is configured"}
                             "send_updates" {"type"        "string"
                                              "description" "Google sendUpdates value: all, externalOnly, or none"}}
               "required"   ["event_id"]}
 :handler-var xia.tool.builtin/calendar-event-delete}
