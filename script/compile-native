#!/bin/bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
STAGING_DIR="$(mktemp -d "${TMPDIR:-/tmp}/xia-native-release.XXXXXX")"
STAGED_JAR="$STAGING_DIR/xia.jar"

cleanup() {
  rm -rf "$STAGING_DIR"
}

trap cleanup EXIT

if [ -n "${GRAALVM_HOME:-}" ]; then
  export JAVA_HOME="$GRAALVM_HOME"
  export PATH="$GRAALVM_HOME/bin:$PATH"
elif ! command -v native-image >/dev/null 2>&1; then
  echo "Please set GRAALVM_HOME or ensure native-image is on PATH"
  exit 1
fi

cd "$ROOT_DIR"

lein clean
lein with-profile -user,-dev,+release uberjar
cp "$ROOT_DIR/target/xia.jar" "$STAGED_JAR"
lein clean

mkdir -p "$ROOT_DIR/target/native-tmp/.tmp" "$ROOT_DIR/target/native-image"

NATIVE_IMAGE_HEAP="${XIA_NATIVE_IMAGE_HEAP:-10g}"
case "$(uname -s):$(uname -m)" in
  Darwin:arm64|Darwin:aarch64)
    PLAYWRIGHT_DRIVER_PLATFORM="mac-arm64"
    ;;
  Darwin:x86_64)
    PLAYWRIGHT_DRIVER_PLATFORM="mac"
    ;;
  Linux:arm64|Linux:aarch64)
    PLAYWRIGHT_DRIVER_PLATFORM="linux-arm64"
    ;;
  Linux:x86_64|Linux:amd64)
    PLAYWRIGHT_DRIVER_PLATFORM="linux"
    ;;
  *)
    echo "Unsupported native build platform for Playwright: $(uname -s) $(uname -m)"
    exit 1
    ;;
esac
NATIVE_IMAGE_FLAGS=(
  -H:+AddAllCharsets
  -Djava.awt.headless=true
  "-H:IncludeResources=driver/package.*"
  "-H:IncludeResources=driver/${PLAYWRIGHT_DRIVER_PLATFORM}.*"
  "-J-Xmx${NATIVE_IMAGE_HEAP}"
)

if [ -n "${XIA_NATIVE_PGO_PROFILE:-}" ]; then
  NATIVE_IMAGE_FLAGS+=("--pgo=${XIA_NATIVE_PGO_PROFILE}")
fi

if [ "${XIA_NATIVE_MARCH_NATIVE:-0}" = "1" ]; then
  NATIVE_IMAGE_FLAGS+=("-H:CCompilerOption=-march=native")
fi

env TMPDIR="$ROOT_DIR/target/native-tmp/.tmp" \
  native-image \
  --verbose \
  -H:TempDirectory=target/native-tmp \
  -H:Path=target/native-image \
  "${NATIVE_IMAGE_FLAGS[@]}" \
  -jar "$STAGED_JAR" \
  -H:Name=xia
